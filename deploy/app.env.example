# 原生部署环境变量模板（阿里云 ECS + systemd + 本机 PostgreSQL 18 / Redis 8）
#
# 用法：
#   cp deploy/app.env.example /opt/visionspace/app.env
#   chmod 600 /opt/visionspace/app.env && chown root:root /opt/visionspace/app.env
#   vi /opt/visionspace/app.env        # 把 <> 占位全部替换成真实值
#
# 规矩：
#   1. 这里的值全是占位说明，**禁止**把填好的文件提交进仓库；
#   2. 口令只经本文件注入（systemd EnvironmentFile），不进 argv、不进日志、不进 compose 参数；
#   3. 缺项、空白、开发回退值或没替换的占位符，应用会在创建任何业务 Bean 之前拒绝启动
#      （ProductionSecretsGuard，错误只给键名）；
#   4. 键名对照表见 deploy/README.md；本文件与 .env.example（compose 口径）不是同一套键。
#
# 改动本文件后必须重跑：python -I scripts/tests/test-deploy-templates.py

# ---- profile 与监听面 ----
# 生产 profile：秘密必须由环境注入，启动时强制校验
SPRING_PROFILES_ACTIVE=prod
# 业务端口只绑回环，nginx 反代到 127.0.0.1:8081。
# 容器部署（docker-compose）会显式覆盖成 0.0.0.0，因为容器内必须监听所有接口才能被端口映射。
SERVER_ADDRESS=127.0.0.1

# ---- PostgreSQL 18（本机原生，双角色）----
# 运行角色只做 DML；迁移角色 vision_migrator 只在 deploy/flyway-migrate.sh 那一步使用
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/vision_space_prod?ApplicationName=vision-space&sslmode=disable
SPRING_DATASOURCE_USERNAME=vision_app
SPRING_DATASOURCE_PASSWORD=<运行角色口令>

# ---- Redis 8（本机原生）----
# 不能写 127.0.0.1/localhost：生产守卫会把回环地址判为开发回退值并拒绝启动。
# 用 /etc/hosts 里的别名指向 127.0.0.1（见 deploy/README.md §3）。
SPRING_DATA_REDIS_HOST=vision-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<Redis 口令>

# ---- 模型供应商 ----
# base-url 缺省会打 api.openai.com（大陆不可达），Agent 同步调用会挂到超时、SSE 一个字节都回不来。
# 默认值已是 DashScope 兼容模式；换供应商时这两个键必须一起改。
SPRING_AI_DASHSCOPE_API_KEY=<DashScope API Key>
SPRING_AI_OPENAI_API_KEY=<OpenAI 兼容端点的 API Key>
SPRING_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=qwen-plus
ALI_YUN_AI_API_KEY=<阿里云百炼 API Key>

# ---- 外部服务 ----
VISION_SPACE_PEXELS_API_KEY=<Pexels API Key>
VISION_SPACE_VISION_RECOGNITION_API_KEY=<视觉识别服务 API Key>
VISION_SPACE_VISION_RECOGNITION_BASE_URL=https://www.dmxapi.cn
VISION_SPACE_VISION_RECOGNITION_MODEL=GLM-4.1V-Thinking-Flash

# ---- 安全 ----
# 新建用户的初始口令，至少 8 位；不要用 12345678（守卫会拒绝开发回退值）
VISION_SPACE_DEFAULT_PASSWORD=<至少 8 位且不是默认口令>
# 跨站可信来源（必须带协议）。同源访问不受限制，留空表示只信同源
VISION_SPACE_TRUSTED_ORIGINS=

# ---- Agent 流式会话 ----
# MVC 异步请求超时（毫秒）。默认 30 秒会把「首帧还没到」的会话掐断，客户端一个帧都收不到。
# 这是止血兜底，不是首帧延迟的根因修复——根因定位见 docs/plans/2026-11-26-production-readiness.md 的 WP-02。
SPRING_MVC_ASYNC_REQUEST_TIMEOUT=300000

# ---- 站内图片检索（本版关闭；pgvector 下一轮）----
SPRING_AI_VECTORSTORE_TYPE=none
SPRING_AI_MODEL_EMBEDDING_TEXT=none

# ---- 微信小程序（可选；缺失不影响启动，只有 /user/wx/* 会返回失败）----
VISION_SPACE_WX_APPID=
VISION_SPACE_WX_SECRET=

# ---- 时区与日志 ----
# 库、JDBC 会话、JVM 三者同区：timestamp(0) 存墙钟时间，API 输出不带偏移
TZ=Asia/Shanghai
PGTZ=Asia/Shanghai
LOGGING_FILE_NAME=/opt/visionspace/logs/app.log
