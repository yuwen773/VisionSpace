@import './styles/tokens.wxss';

page {
  background: var(--vs-bg);
  color: var(--vs-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
image,
input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--vs-bg);
}

/* 通用状态块：加载失败 / 空列表 / 占位 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  color: var(--vs-text-secondary);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--vs-text-tertiary);
}

.retry-btn {
  margin-top: 32rpx;
  padding: 14rpx 48rpx;
  border: 1rpx solid var(--vs-border-strong);
  border-radius: 999rpx;
  color: var(--vs-primary);
  font-size: 26rpx;
}

.footer-end {
  padding: 40rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--vs-text-tertiary);
}
