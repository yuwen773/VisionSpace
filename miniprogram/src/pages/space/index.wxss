.brand {
  padding: 72rpx 8rpx 40rpx;
}

.brand-name {
  color: var(--vs-text);
  font-size: 48rpx;
  font-weight: 700;
}

.brand-slogan {
  margin-top: 12rpx;
  color: var(--vs-text-tertiary);
  font-size: 26rpx;
}

.panel {
  overflow: hidden;
  border-radius: var(--vs-radius-lg);
  background: var(--vs-surface);
  box-shadow: var(--vs-shadow-card);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--vs-border-subtle);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--vs-text);
  font-size: 28rpx;
}

.row-value {
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.primary-btn {
  margin-top: 48rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--vs-primary);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.primary-btn::after {
  border: none;
}

.greeting {
  padding: 32rpx 8rpx 24rpx;
}

.greeting-name {
  color: var(--vs-text);
  font-size: 40rpx;
  font-weight: 600;
}

.greeting-sub {
  margin-top: 8rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
}

.space-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 30rpx 28rpx;
  border-radius: var(--vs-radius-lg);
  background: var(--vs-surface);
  box-shadow: var(--vs-shadow-card);
}

.space-card-main {
  flex: 1;
  min-width: 0;
}

.space-name {
  overflow: hidden;
  color: var(--vs-text);
  font-size: 30rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.space-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.badge {
  margin-right: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--vs-surface-hover);
  color: var(--vs-text-secondary);
  font-size: 20rpx;
}

.role {
  color: var(--vs-text-tertiary);
  font-size: 22rpx;
}

.chevron {
  margin-left: 16rpx;
  color: var(--vs-text-tertiary);
  font-size: 40rpx;
  line-height: 1;
}
