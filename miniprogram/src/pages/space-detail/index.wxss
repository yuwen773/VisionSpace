.header {
  padding: 24rpx 8rpx 16rpx;
}

.title {
  color: var(--vs-text);
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 8rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.dot {
  margin: 0 8rpx;
}

.color-bar {
  margin: 8rpx -24rpx 0;
  padding: 12rpx 24rpx 16rpx;
  background: var(--vs-bg-secondary);
}

.swatches {
  white-space: nowrap;
}

.swatch {
  display: inline-block;
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border: 3rpx solid transparent;
  border-radius: 50%;
  box-sizing: border-box;
  vertical-align: middle;
}

.swatch-active {
  border-color: var(--vs-text);
}

.color-actions {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.color-action {
  margin-right: 28rpx;
  color: var(--vs-primary);
  font-size: 24rpx;
}

.filter-summary {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 8rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.filter-dot {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 16rpx;
}

.grid-item {
  width: 343rpx;
  margin-bottom: 16rpx;
}
