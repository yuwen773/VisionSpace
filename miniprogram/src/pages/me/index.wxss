.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--vs-tint);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--vs-primary);
  font-size: 44rpx;
  font-weight: 600;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name {
  overflow: hidden;
  color: var(--vs-text);
  font-size: 44rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-sub {
  margin-top: 8rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.profile-action {
  flex: none;
  margin-left: 20rpx;
  color: var(--vs-primary);
  font-size: 28rpx;
}

.panel {
  margin-top: 8rpx;
}

.logout-btn {
  margin-top: 40rpx;
  padding: 0;
  border: none;
  background: transparent;
  color: var(--vs-primary);
  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
}

.logout-btn::after {
  border: none;
}

.note {
  margin-top: 48rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}
