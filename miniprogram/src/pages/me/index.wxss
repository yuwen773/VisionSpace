.profile {
  display: flex;
  align-items: center;
  padding: 48rpx 8rpx 40rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--vs-surface-hover);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--vs-primary);
  font-size: 44rpx;
  font-weight: 600;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name {
  overflow: hidden;
  color: var(--vs-text);
  font-size: 36rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-sub {
  margin-top: 8rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.profile-action {
  padding: 12rpx 36rpx;
  border: 1rpx solid var(--vs-border-strong);
  border-radius: 999rpx;
  color: var(--vs-primary);
  font-size: 26rpx;
}

.panel {
  overflow: hidden;
  border-radius: var(--vs-radius-lg);
  background: var(--vs-surface);
  box-shadow: var(--vs-shadow-card);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--vs-border-subtle);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--vs-text);
  font-size: 28rpx;
}

.row-value {
  color: var(--vs-text-secondary);
  font-size: 26rpx;
}

.logout-btn {
  margin-top: 40rpx;
  border: 1rpx solid var(--vs-border);
  border-radius: 999rpx;
  background: transparent;
  color: var(--vs-accent);
  font-size: 28rpx;
  line-height: 84rpx;
}

.logout-btn::after {
  border: none;
}

.note {
  margin-top: 40rpx;
  color: var(--vs-text-tertiary);
  font-size: 22rpx;
  text-align: center;
}
