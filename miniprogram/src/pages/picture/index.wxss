.detail {
  padding: 0 40rpx;
}

/* 主图占满左右：一屏一张纸 */
.hero {
  margin: 0 -40rpx;
  background: var(--vs-bg-secondary);
}

.hero-image {
  display: block;
  width: 100%;
}

.hero-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 520rpx;
  background: var(--vs-tint);
}

.content {
  padding: 24rpx 0 48rpx;
}

.label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.label-accent {
  color: var(--vs-primary);
  font-size: 24rpx;
}

.label-meta {
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.title {
  margin-top: 12rpx;
  color: var(--vs-text);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
}

.intro {
  margin-top: 16rpx;
  color: var(--vs-text-secondary);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.meta-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 0;
}

.meta-author {
  color: var(--vs-text-secondary);
  font-size: 24rpx;
}

.meta-size {
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.counts {
  display: flex;
  margin-top: 8rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--vs-rule);
  border-bottom: 1rpx solid var(--vs-rule);
}

.count {
  flex: 1;
}

.count-value {
  color: var(--vs-text);
  font-size: 44rpx;
  line-height: 1.2;
}

.count-label {
  margin-top: 6rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
}

.tags {
  margin-top: 20rpx;
}

.tag {
  margin-right: 20rpx;
  color: var(--vs-text-tertiary);
  font-size: 26rpx;
}

.share-btn {
  margin-top: 40rpx;
}

.hint {
  margin-top: 24rpx;
  color: var(--vs-text-tertiary);
  font-size: 24rpx;
  line-height: 1.7;
}
