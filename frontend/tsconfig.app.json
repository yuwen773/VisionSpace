{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      // vue-cropper 1.1.4 typings import an unpublished .vue file (TS7016);
      // point the specifier at the local shim instead.
      "vue-cropper": ["./src/types/vue-cropper.d.ts"]
    },
    "types": ["vitest/globals"]
  }
}
