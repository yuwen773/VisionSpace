# 复制为 .env.local 后按部署情况填写。这里只有非秘密的部署目标配置。

# 后端入口。留空表示同源（开发走 vite 代理，生产走反向代理）。
VITE_API_BASE_URL=

# 受控自托管 PlantUML 服务地址（例如 https://uml.internal.example）。
# 留空则 PlantUML 代码块只显示源码，绝不回退公共渲染服务。
# 该地址同时用于生成 CSP 的 img-src；内容本身不能改变这个目标。
VITE_PLANTUML_SERVER=

# 允许在对话里直接加载的图片主机（逗号分隔，例如 https://cdn.internal.example）。
# 留空表示只有本站内容可以加载；未列出的主机的图片不会生成 <img>，
# 因此不会产生任何外发请求。
VITE_CSP_IMAGE_HOSTS=
