<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuwen.visionspace.mapper.PictureActionEventDedupeMapper">

    <!--
      登记一次事件受理。事件幂等键是唯一键，冲突时 DO NOTHING：
      影响行数 1 表示首次受理，0 表示同一事件重放。
      用 ON CONFLICT 而不是捕获唯一约束异常：PostgreSQL 中任何语句报错都会
      把当前事务置为 aborted，捕获后继续写库会得到 25P02。
    -->
    <insert id="insertEvidence">
        INSERT INTO picture_action_event_dedupe (event_id, created_time)
        VALUES (#{eventId}, statement_timestamp())
        ON CONFLICT (event_id) DO NOTHING
    </insert>

</mapper>
