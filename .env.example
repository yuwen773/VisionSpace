# 复制为 .env 后填写。所有值都是占位说明，不得提交真实凭据。
# 本地 `mvn spring-boot:run` / IDE 直跑不原生读 .env，需先导出：
#   set -a; . ./.env; set +a; mvn spring-boot:run     （Git Bash / Linux / macOS）
#   Get-Content .env | ForEach-Object { ... }          （PowerShell，见 CLAUDE.md）
# compose 会自动读取 .env 做变量插值；prod 由 ProductionSecretsGuard 校验必需项。
# 生产部署时同样的键通过受控秘密配置注入，缺失会使应用拒绝启动。
# 本地开发用默认值（MySQL/Redis 在 localhost）时，下面绝大多数键可留空。
# 注意：application.yml 不再内置 123456 之类的开发密码回退；本地 MySQL/Redis
# 若设了密码，必须在这里显式填写，留空即表示空密码。

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=vision_space

# Redis
REDIS_PASSWORD=your_redis_password

# 后端
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# 宿主受限访问（docker-compose.host-access.yml 用，默认关闭）
# HOST_MYSQL_PORT=13306
# HOST_REDIS_PORT=16379

# ---- 生产必需项（SPRING_PROFILES_ACTIVE=prod 时缺失即拒绝启动）----
# 数据库
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/vision_space
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
# Redis
SPRING_DATA_REDIS_HOST=your-redis-host
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password
# 外部服务
SPRING_AI_OPENAI_API_KEY=your_dashscope_key
SPRING_AI_DASHSCOPE_API_KEY=your_dashscope_key
ALI_YUN_AI_API_KEY=your_dashscope_key
VISION_SPACE_PEXELS_API_KEY=your_pexels_key
VISION_SPACE_VISION_RECOGNITION_API_KEY=your_vision_recognition_key
# 新建用户的初始密码
VISION_SPACE_DEFAULT_PASSWORD=change_me_before_production

# ---- 非 prod 也生效的可选覆盖（基线的 ${VAR:} 占位）----
# 本地 MySQL/Redis 密码；基线不再内置开发回退，留空即表示空密码
MYSQL_PASSWORD=
REDIS_PASSWORD=
# 图片识别服务的非秘密参数（基线已有默认值）
# VISION_SPACE_VISION_RECOGNITION_BASE_URL=https://www.dmxapi.cn
# VISION_SPACE_VISION_RECOGNITION_MODEL=GLM-4.1V-Thinking-Flash
